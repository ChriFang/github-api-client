{
  "name": "git-client-flash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A lightweight GitHub client built on api.github.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "mock": "node scripts/mock-server.mjs",
    "smoke": "esbuild src/lib/api.ts --bundle --format=esm --platform=node --outfile=.tmp/api.mjs && node scripts/api-smoke.mjs",
    "archive-smoke": "esbuild src/lib/archive.ts --bundle --format=esm --platform=node --outfile=.tmp/archive.mjs && node scripts/archive-smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "fflate": "^0.8.3",
    "marked": "^15.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
